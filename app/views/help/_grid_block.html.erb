<% grid_style = "grid-column: #{help_block.column_start} / span #{help_block.column_span}; grid-row: #{help_block.row_start} / span #{help_block.row_span};" %>

<% if editing %>
  <%= form_with model: help_block,
                url: help_block_path(help_block),
                method: :patch,
                html: {
                  class: 'help-grid-block help-grid-block__form',
                  id: "help-block-#{help_block.to_param}",
                  style: grid_style,
                  data: {
                    help_grid_item: true,
                    help_block_id: help_block.to_param
                  },
                  autocomplete: 'off'
                } do |form| %>
    <span class="help-grid-block__resize-edge help-grid-block__resize-edge--top" data-help-resize-edge="top"></span>
    <span class="help-grid-block__resize-edge help-grid-block__resize-edge--right" data-help-resize-edge="right"></span>
    <span class="help-grid-block__resize-edge help-grid-block__resize-edge--bottom" data-help-resize-edge="bottom"></span>
    <span class="help-grid-block__resize-edge help-grid-block__resize-edge--left" data-help-resize-edge="left"></span>
    <span class="help-grid-block__resize-corner help-grid-block__resize-corner--top-left" data-help-resize-edge="top,left"></span>
    <span class="help-grid-block__resize-corner help-grid-block__resize-corner--top-right" data-help-resize-edge="top,right"></span>
    <span class="help-grid-block__resize-corner help-grid-block__resize-corner--bottom-right" data-help-resize-edge="bottom,right"></span>
    <span class="help-grid-block__resize-corner help-grid-block__resize-corner--bottom-left" data-help-resize-edge="bottom,left"></span>

    <%= form.hidden_field :style_variant, value: help_block.style_variant, data: { help_grid_field: 'style_variant' } %>
    <%= form.hidden_field :locale, value: help_block.locale %>
    <%= form.hidden_field :column_start, data: { help_grid_field: 'column_start' } %>
    <%= form.hidden_field :column_span, data: { help_grid_field: 'column_span' } %>
    <%= form.hidden_field :row_start, data: { help_grid_field: 'row_start' } %>
    <%= form.hidden_field :row_span, data: { help_grid_field: 'row_span' } %>

    <div class="help-grid-block__controls">
      <span class="help-grid-block__drag-handle" data-help-move-handle role="button" tabindex="0" aria-label="<%= t('help.show.editor.move') %>">
        <span class="help-grid-block__drag-dots" aria-hidden="true">
          <span></span>
          <span></span>
          <span></span>
          <span></span>
        </span>
      </span>

      <button type="button" class="help-grid-block__delete" data-help-delete-card aria-label="<%= t('help.show.editor.delete') %>">
        <svg class="help-grid-block__icon-svg" viewBox="0 0 10 10" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" focusable="false">
          <path d="M1 1L9 9" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/>
          <path d="M9 1L1 9" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/>
        </svg>
      </button>
    </div>

    <div class="help-grid-block__editor-surface">
      <%= form.text_area :body,
                         class: 'help-grid-block__textarea',
                         placeholder: t('help.show.editor.placeholders.body'),
                         rows: 8,
                         data: { help_card_field: 'body' } %>

      <div class="help-grid-block__editor"
           data-help-card-editor
           contenteditable="true"
           role="textbox"
           aria-multiline="true"
           dir="ltr"
           spellcheck="true"
           data-placeholder="<%= t('help.show.editor.placeholders.body') %>"><%= render_markdown(help_block.body) %></div>
    </div>
  <% end %>
<% else %>
  <article id="help-block-<%= help_block.to_param %>" class="help-grid-block" style="<%= grid_style %>">
    <div class="help-grid-block__content">
      <div class="help-grid-block__body"><%= render_markdown(help_block.body) %></div>
    </div>
  </article>
<% end %>