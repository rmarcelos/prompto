<% content_for :title, "#{t('help.show.title')} - Prompto" %>

<% if @editing_help %>
  <% editor_config = {
    locale: @help_locale,
    storageKey: "help-draft:v5:#{request.path}:#{@help_locale}",
    draftAvailable: @help_draft&.saved_at.present?,
    initialPageState: (@help_draft&.saved_at.present? ? 'idle' : 'dirty'),
    initialPageStatus: (@help_draft&.saved_at.present? ? t('help.show.editor.draft_saved_at', time: l(@help_draft.saved_at, format: :short)) : t('help.show.editor.session_hint')),
    paths: {
      saveDraft: help_draft_path(format: :json, help_locale: @help_locale),
      publishDraft: publish_help_draft_path(format: :json, help_locale: @help_locale),
      closeEditor: help_path(help_locale: @help_locale)
    },
    defaults: {
      body: t('help.show.editor.new_card_body')
    },
    labels: {
      move: t('help.show.editor.move'),
      delete: t('help.show.editor.delete'),
      deleteConfirm: t('help.show.editor.delete_confirm'),
      bodyPlaceholder: t('help.show.editor.placeholders.body'),
      emptyTitle: t('help.show.empty.title'),
      emptyBody: t('help.show.empty.body'),
      sessionRestored: t('help.show.editor.session_restored'),
      sessionHint: t('help.show.editor.session_hint'),
      localDirty: t('help.show.editor.local_dirty'),
      cardAdded: t('help.show.editor.card_added'),
      cardDeleted: t('help.show.editor.card_deleted'),
      draftSaving: t('help.show.editor.draft_saving'),
      draftSavedAt: t('help.show.editor.draft_saved_at', time: '%{time}'),
      saveError: t('help.show.editor.save_error'),
      publishing: t('help.show.editor.publishing'),
      publishedAt: t('help.show.editor.published_at', time: '%{time}'),
      publishError: t('help.show.editor.publish_error')
    },
    formatting: {
      menuTitle: t('help.show.editor.formatting.menu_title'),
      chooseOption: t('help.show.editor.formatting.choose_option'),
      textLabel: t('help.show.editor.formatting.text_label'),
      markerLabel: t('help.show.editor.formatting.marker_label'),
      sizeLabel: t('help.show.editor.formatting.size_label'),
      blockLabel: t('help.show.editor.formatting.block_label'),
      textStyles: [
        { value: 'bold', label: t('help.show.editor.formatting.text_options.bold') },
        { value: 'italic', label: t('help.show.editor.formatting.text_options.italic') },
        { value: 'underline', label: t('help.show.editor.formatting.text_options.underline') }
      ],
      markers: [
        { value: 'highlight_green', label: t('help.show.editor.formatting.marker_options.added') },
        { value: 'highlight_yellow', label: t('help.show.editor.formatting.marker_options.changed') },
        { value: 'highlight_red', label: t('help.show.editor.formatting.marker_options.removed') }
      ],
      sizes: [
        { value: 'size_sm', label: t('help.show.editor.formatting.size_options.small') },
        { value: 'size_md', label: t('help.show.editor.formatting.size_options.medium') },
        { value: 'size_lg', label: t('help.show.editor.formatting.size_options.large') }
      ],
      blocks: [
        { value: 'unordered_list', label: t('help.show.editor.formatting.block_options.bullets') },
        { value: 'ordered_list', label: t('help.show.editor.formatting.block_options.enumeration') },
        { value: 'code_block', label: t('help.show.editor.formatting.block_options.code') }
      ]
    }
  } %>

  <% help_delete_confirmation_content = capture do %>
    <div class="app-confirmation-modal-stack">
      <p class="app-confirmation-modal-content"><%= t('help.show.editor.delete_modal.description') %></p>

      <div class="app-confirmation-modal-footer">
        <button type="button" class="btn btn-outline-secondary" data-delete-modal-close="help-delete-confirmation-modal"><%= t('common.cancel') %></button>
        <button type="button" class="btn btn-outline-danger" data-help-delete-confirm><%= t('help.show.editor.delete_modal.confirm') %></button>
      </div>
    </div>
  <% end %>

  <script type="application/json" data-help-editor-config><%= raw(json_escape(editor_config.to_json)) %></script>
<% end %>

<div class="container app-page-shell py-5 help-shell">
  <section class="help-page-header">
    <div class="help-page-header__content">
      <h1 class="h3 mb-0"><%= t('help.show.title') %></h1>

      <% if @can_edit_help && @editing_help %>
        <div class="dropdown help-locale-dropdown app-dropdown app-dropdown--auto-width" data-help-locale-selector>
          <button class="btn help-locale-toggle app-dropdown__toggle" type="button" data-bs-toggle="dropdown" data-bs-offset="0,10" aria-expanded="false" aria-label="<%= t('help.show.editor.language_button') %>">
            <span class="help-locale-toggle__label app-dropdown__label"><%= @help_locale_label %></span>
            <span class="help-locale-toggle__icon app-dropdown__icon app-dropdown__icon--rotates" aria-hidden="true">
              <span class="app-dropdown__icon-glyph">
                <svg viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg" focusable="false">
                  <path d="M3.5 6L8 10.5L12.5 6" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
              </span>
            </span>
          </button>

          <ul class="dropdown-menu help-locale-menu app-dropdown__menu">
            <% @help_locale_options.each do |locale_option| %>
              <li>
                <%= link_to locale_option[:label],
                            help_path(edit: true, help_locale: locale_option[:value]),
                            class: "dropdown-item help-locale-menu__item app-dropdown__item #{'active' if locale_option[:value] == @help_locale}",
                            aria: (locale_option[:value] == @help_locale ? { current: 'true' } : {}) %>
              </li>
            <% end %>
          </ul>
        </div>
      <% end %>
    </div>

    <% if @can_edit_help %>
      <% if @editing_help %>
        <div class="help-page-header__actions">
          <p class="help-page-header__status" data-help-page-status data-state="<%= @help_draft&.saved_at.present? ? 'idle' : 'dirty' %>">
            <%= @help_draft&.saved_at.present? ? t('help.show.editor.draft_saved_at', time: l(@help_draft.saved_at, format: :short)) : t('help.show.editor.session_hint') %>
          </p>

          <div class="help-page-header__toolbar">
            <%= link_to t('help.show.editor.close'), help_path(help_locale: @help_locale), class: 'btn btn-outline-dark rounded-pill px-4' %>

            <button type="button" class="btn btn-outline-dark rounded-pill px-4" data-help-add-card><%= t('help.show.editor.create') %></button>
            <button type="button" class="btn btn-outline-dark rounded-pill px-4" data-help-save-draft><%= t('help.show.editor.save_draft') %></button>
            <button type="button" class="btn help-publish-button rounded-pill px-4" data-help-publish-draft <%= 'disabled' unless @help_draft&.saved_at.present? %>><%= t('help.show.editor.publish') %></button>
          </div>
        </div>
      <% else %>
        <div class="help-page-header__actions">
          <div class="help-page-header__toolbar">
            <%= link_to t('help.show.editor.edit'), help_path(edit: true, help_locale: @help_locale), class: 'btn btn-dark rounded-pill px-4' %>
          </div>
        </div>
      <% end %>
    <% end %>
  </section>

  <section class="help-grid-board <%= 'help-grid-board--editing' if @editing_help %>" data-help-grid-board data-columns="8" data-gap="10" style="--help-grid-row-count: <%= @grid_rows %>">
    <% if @help_blocks.any? %>
      <%= render partial: 'grid_block', collection: @help_blocks, as: :help_block, locals: { editing: @editing_help } %>
    <% else %>
      <div class="help-grid-empty-state">
        <div>
          <h2 class="h5 mb-2"><%= t('help.show.empty.title') %></h2>
          <p class="mb-0"><%= t('help.show.empty.body') %></p>
        </div>
      </div>
    <% end %>
  </section>
</div>

<% if @editing_help %>
  <%= render partial: 'shared/confirmation_modal', locals: {
    modal_id: 'help-delete-confirmation-modal',
    title: t('help.show.editor.delete_modal.title'),
    subtitle: t('help.show.editor.delete_modal.subtitle'),
    close_aria: t('shared.delete_confirmation_modal.close_aria'),
    delete_controlled: true,
    close_data_attribute_value: 'help-delete-confirmation-modal',
    content: help_delete_confirmation_content
  } %>
<% end %>