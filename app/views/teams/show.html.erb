<% content_for :title, "#{@team.name} - Prompto" %>

<% role_label = lambda do |membership|
     membership.is_group_mod ? t('teams.memberships.roles.moderator') : t('teams.memberships.roles.member')
   end %>

<style data-turbo-track="dynamic">
  .team-page-shell {
    max-width: 1080px;
  }

  .team-neutral-action-button {
    border-color: #000000;
    color: #000000;
  }

  .team-neutral-action-button:hover,
  .team-neutral-action-button:focus-visible {
    background-color: #000000;
    border-color: #000000;
    color: #ffffff;
  }

  .team-members-table th,
  .team-members-table td {
    text-align: center;
    vertical-align: middle;
  }

  .team-members-actions {
    display: inline-flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    justify-content: center;
  }

  .team-members-modal-backdrop {
    position: fixed;
    inset: 0;
    z-index: 1080;
    background: rgba(24, 24, 27, 0.48);
    display: none;
    align-items: center;
    justify-content: center;
    padding: 1rem;
  }

  .team-members-modal-backdrop.is-open {
    display: flex;
  }

  .team-members-modal-card {
    width: min(640px, 100%);
    background: #fff;
    border-radius: 18px;
    border: 1px solid rgba(61, 53, 47, 0.08);
    box-shadow: 0 18px 40px rgba(61, 53, 47, 0.18);
  }

  .team-members-modal-header,
  .team-members-modal-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    padding: 1rem 1.1rem;
    border-bottom: 1px solid rgba(61, 53, 47, 0.08);
  }

  .team-members-modal-footer {
    border-bottom: none;
    border-top: 1px solid rgba(61, 53, 47, 0.08);
  }

  .team-members-modal-body {
    padding: 1rem 1.1rem;
  }

  .team-members-modal-close {
    border: none;
    background: transparent;
    color: #6b7280;
    font-size: 1rem;
  }
</style>

<div class="container py-5 team-page-shell">
  <div class="d-flex flex-wrap justify-content-between align-items-start gap-3 mb-4">
    <div>
      <h1 class="h3 mb-1"><%= @team.name %></h1>
      <% unless @team.creator&.email == 'system@app.local' %>
        <p class="text-muted mb-1"><%= t('teams.show.creator') %>: <%= @team.creator.name %></p>
      <% end %>
      <p class="text-muted mb-0"><%= t('teams.show.prompts_count') %>: <%= @team.prompt_teams.count %></p>
    </div>

    <div class="d-inline-flex gap-2">
      <%= link_to t('common.back'), teams_path, class: 'btn btn-outline-dark team-action-button team-neutral-action-button' %>
      <% if @can_manage_team %>
        <%= link_to t('teams.show.edit_team'), edit_team_path(@team), class: 'btn btn-outline-dark team-action-button team-neutral-action-button' %>
        <%= render partial: 'shared/delete_confirmation_modal', locals: {
          trigger_label: t('common.delete'),
          trigger_class: 'btn btn-outline-danger',
          modal_id: "delete-team-#{@team.id}",
          delete_url: team_path(@team),
          resource_name: t('teams.resource_name'),
          confirm_class: 'btn btn-outline-danger',
          cancel_class: 'btn btn-outline-secondary'
        } %>
        <button type="button" class="btn btn-dark" data-team-members-modal-open="true"><%= t('teams.show.add_member') %></button>
      <% end %>
    </div>
  </div>

  <% unless @can_manage_team %>
    <div class="alert alert-light border"><%= t('teams.show.no_permission') %></div>
  <% end %>

  <div class="card border-0 shadow-sm">
    <div class="card-body p-4">
      <h2 class="h5 mb-3"><%= t('teams.show.members_title') %></h2>

      <% if @team_memberships.any? %>
        <div class="table-responsive">
          <table class="table align-middle mb-0 team-members-table">
            <thead>
              <tr>
                <th class="text-center"><%= t('teams.show.member_column') %></th>
                <th class="text-center"><%= t('teams.show.email_column') %></th>
                <th class="text-center"><%= t('teams.show.role_column') %></th>
                <th class="text-center"><%= t('teams.show.actions_column') %></th>
              </tr>
            </thead>
            <tbody>
              <% @team_memberships.each do |membership| %>
                <tr>
                  <td class="fw-semibold"><%= membership.user.name %></td>
                  <td><%= membership.user.email %></td>
                  <td>
                    <% if @can_manage_team && membership.user_id != @team.creator_id %>
                      <%= form_with model: membership, url: team_team_user_path(@team, membership.user), method: :patch, local: true, class: 'd-flex gap-2 align-items-center justify-content-center' do |form| %>
                        <%= form.select :is_group_mod,
                          options_for_select([[t('teams.memberships.roles.member'), false], [t('teams.memberships.roles.moderator'), true]], membership.is_group_mod),
                          {},
                          class: 'form-select form-select-sm' %>
                        <%= form.submit t('teams.memberships.update_button'), class: 'btn btn-sm btn-outline-dark team-action-button team-neutral-action-button' %>
                      <% end %>
                    <% else %>
                      <span><%= role_label.call(membership) %></span>
                    <% end %>
                  </td>
                  <td>
                    <div class="team-members-actions">
                      <%= link_to t('teams.show.view_profile'), user_path(membership.user), class: 'btn btn-sm btn-outline-dark team-action-button team-neutral-action-button' %>
                      <%= link_to t('common.edit'), edit_user_path(membership.user), class: 'btn btn-sm btn-outline-dark team-action-button team-neutral-action-button' %>
                      <% if @can_manage_team && membership.user_id != @team.creator_id %>
                        <%= render partial: 'shared/delete_confirmation_modal', locals: {
                          trigger_label: t('teams.memberships.remove_button'),
                          trigger_class: 'btn btn-sm btn-outline-danger',
                          modal_id: "delete-team-membership-#{@team.id}-#{membership.user_id}",
                          delete_url: team_team_user_path(@team, membership.user),
                          resource_name: t('teams.memberships.member_resource_name', user_name: membership.user.name),
                          confirm_class: 'btn btn-outline-danger',
                          cancel_class: 'btn btn-outline-secondary'
                        } %>
                      <% else %>
                        <button type="button" class="btn btn-sm btn-outline-danger" disabled><%= t('teams.memberships.remove_button') %></button>
                      <% end %>
                    </div>
                  </td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      <% else %>
        <div class="alert alert-light border mb-0"><%= t('teams.show.empty_members') %></div>
      <% end %>
    </div>
  </div>
</div>

<% if @can_manage_team %>
  <div class="team-members-modal-backdrop" data-team-members-modal hidden>
    <div class="team-members-modal-card" role="dialog" aria-modal="true" aria-labelledby="team-members-modal-title">
      <div class="team-members-modal-header">
        <div>
          <h2 id="team-members-modal-title" class="h5 mb-1"><%= t('teams.memberships.modal.title') %></h2>
          <p class="text-muted mb-0"><%= t('teams.memberships.modal.subtitle') %></p>
        </div>

        <button type="button" class="team-members-modal-close" data-team-members-modal-close="true" aria-label="<%= t('teams.memberships.modal.close_aria') %>">
          <i class="bi bi-x-lg"></i>
        </button>
      </div>

      <div class="team-members-modal-body">
        <% if @available_users.any? %>
          <%= form_with model: TeamUser.new, url: team_team_users_path(@team), local: true do |form| %>
            <div class="mb-3">
              <%= form.label :user_id, t('teams.show.member_column'), class: 'form-label fw-semibold' %>
              <%= form.select :user_id, options_from_collection_for_select(@available_users, :id, :name), {}, class: 'form-select' %>
            </div>

            <div class="mb-3">
              <%= form.label :is_group_mod, t('teams.show.role_column'), class: 'form-label fw-semibold' %>
              <%= form.select :is_group_mod,
                options_for_select([[t('teams.memberships.roles.member'), false], [t('teams.memberships.roles.moderator'), true]], false),
                {},
                class: 'form-select' %>
            </div>

            <div class="team-members-modal-footer px-0 pb-0 pt-3">
              <span class="text-muted small"><%= t('teams.memberships.available_users_count', count: @available_users.count) %></span>
              <%= form.submit t('teams.memberships.create_button'), class: 'btn btn-dark' %>
            </div>
          <% end %>
        <% else %>
          <div class="alert alert-light border mb-0"><%= t('teams.memberships.modal.empty_state') %></div>
        <% end %>
      </div>
    </div>
  </div>

  <script>
    (() => {
      const openButton = document.querySelector('[data-team-members-modal-open="true"]');
      const modal = document.querySelector('[data-team-members-modal]');

      if (!openButton || !modal || modal.dataset.bound === 'true') {
        return;
      }

      const closeModal = () => {
        modal.classList.remove('is-open');
        modal.setAttribute('hidden', 'hidden');
      };

      openButton.addEventListener('click', () => {
        modal.removeAttribute('hidden');
        modal.classList.add('is-open');
      });

      modal.addEventListener('click', (event) => {
        if (event.target === modal || event.target.closest('[data-team-members-modal-close="true"]')) {
          closeModal();
        }
      });

      modal.dataset.bound = 'true';
    })();
  </script>
<% end %>