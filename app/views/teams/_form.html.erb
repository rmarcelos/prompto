<% if @team.errors.any? %>
  <div class="alert alert-danger">
    <strong><%= t('teams.form.error_summary', count: @team.errors.count) %></strong>
    <ul class="mb-0 mt-2">
      <% @team.errors.full_messages.each do |message| %>
        <li><%= message %></li>
      <% end %>
    </ul>
  </div>
<% end %>

<%= form_with model: @team, local: true do |form| %>
  <div class="mb-3">
    <%= form.label :name, class: 'form-label fw-semibold' %>
    <%= form.text_field :name, class: 'form-control', required: true %>
  </div>

  <div class="d-flex gap-2">
    <%= form.submit(@team.persisted? ? t('teams.form.submit_update') : t('teams.form.submit_create'), class: 'btn btn-dark') %>
    <% if @team.persisted? %>
      <%= link_to t('teams.edit.back'), team_path(@team), class: 'btn btn-outline-secondary' %>
    <% else %>
      <%= link_to t('common.cancel'), teams_path, class: 'btn btn-outline-secondary' %>
    <% end %>
  </div>
<% end %>