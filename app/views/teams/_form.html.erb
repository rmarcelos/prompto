<% if @team.errors.any? %>
  <div class="alert alert-danger">
    <strong><%= t('teams.form.error_summary', count: @team.errors.count) %></strong>
    <ul class="mb-0 mt-2">
      <% @team.errors.full_messages.each do |message| %>
        <li><%= message %></li>
      <% end %>
    </ul>
  </div>
<% end %>

<% form_html_class = local_assigns[:form_html_class] %>
<% input_class = local_assigns[:input_class].presence || 'form-control' %>
<% submit_class = local_assigns[:submit_class].presence || 'btn btn-dark team-edit-save-button' %>
<% show_cancel = local_assigns.fetch(:show_cancel, true) %>
<% cancel_path = local_assigns[:cancel_path] %>
<% cancel_label = local_assigns[:cancel_label] %>
<% cancel_class = local_assigns[:cancel_class].presence || 'btn btn-outline-secondary team-edit-back-button' %>

<%= form_with model: @team, local: true, html: { class: form_html_class } do |form| %>
  <div class="mb-3">
    <%= form.label :name, class: 'form-label fw-semibold' %>
    <%= form.text_field :name, class: input_class, required: true %>
  </div>

  <div class="d-flex gap-2">
    <% if show_cancel %>
      <% resolved_cancel_path = cancel_path.presence || (@team.persisted? ? team_path(@team) : teams_path) %>
      <% resolved_cancel_label = cancel_label.presence || (@team.persisted? ? t('teams.edit.back') : t('common.cancel')) %>
      <%= link_to resolved_cancel_label, resolved_cancel_path, class: cancel_class %>
    <% end %>
    <%= form.submit(@team.persisted? ? t('teams.form.submit_update') : t('teams.form.submit_create'), class: submit_class) %>
  </div>
<% end %>