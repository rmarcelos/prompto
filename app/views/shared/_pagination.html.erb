<style data-turbo-track="dynamic">
  .app-pagination-nav {
    margin-bottom: 20px;
  }

  .app-pagination-nav .pagination {
    --bs-pagination-color: #212529;
    --bs-pagination-bg: #ffffff;
    --bs-pagination-border-color: #dee2e6;
    --bs-pagination-hover-color: #212529;
    --bs-pagination-hover-bg: #ffffff;
    --bs-pagination-hover-border-color: #dee2e6;
    --bs-pagination-focus-color: #212529;
    --bs-pagination-focus-bg: #ffffff;
    --bs-pagination-focus-border-color: #dee2e6;
    --bs-pagination-focus-box-shadow: none;
    --bs-pagination-active-color: #ffffff;
    --bs-pagination-active-bg: #212529;
    --bs-pagination-active-border-color: #212529;
    --bs-pagination-disabled-color: #adb5bd;
    --bs-pagination-disabled-bg: #f8f9fa;
    --bs-pagination-disabled-border-color: #dee2e6;
  }

  .app-pagination-nav .page-link {
    text-decoration: none;
    box-shadow: none;
  }

  .app-pagination-nav .page-link:hover,
  .app-pagination-nav .page-link:focus-visible {
    color: var(--bs-pagination-color);
    background: var(--bs-pagination-bg);
    border-color: var(--bs-pagination-border-color);
    text-decoration: none;
    box-shadow: none;
  }
</style>

<% current_page = pagination[:current_page].to_i %>
<% total_pages = pagination[:total_pages].to_i %>
<% pagination_params = base_params.deep_dup %>

<nav class="app-pagination-nav" aria-label="<%= t('shared.pagination.aria') %>">
  <ul class="pagination justify-content-end mb-0">
    <li class="page-item <%= 'disabled' unless current_page > 1 %>">
      <% if current_page > 1 %>
        <%= link_to t('shared.pagination.previous'), url_for(pagination_params.merge(page: current_page - 1)), class: 'page-link' %>
      <% else %>
        <span class="page-link"><%= t('shared.pagination.previous') %></span>
      <% end %>
    </li>

    <li class="page-item <%= 'disabled' unless current_page < total_pages %>">
      <% if current_page < total_pages %>
        <%= link_to t('shared.pagination.next'), url_for(pagination_params.merge(page: current_page + 1)), class: 'page-link' %>
      <% else %>
        <span class="page-link"><%= t('shared.pagination.next') %></span>
      <% end %>
    </li>

    <% pagination_page_series(pagination).each do |page_number| %>
      <li class="page-item <%= 'active' if page_number == current_page %>">
        <% if page_number == current_page %>
          <span class="page-link"><%= page_number %></span>
        <% else %>
          <%= link_to page_number, url_for(pagination_params.merge(page: page_number)), class: 'page-link' %>
        <% end %>
      </li>
    <% end %>

    <li class="page-item <%= 'disabled' unless current_page < total_pages %>">
      <% if current_page < total_pages %>
        <%= link_to t('shared.pagination.last'), url_for(pagination_params.merge(page: total_pages)), class: 'page-link' %>
      <% else %>
        <span class="page-link"><%= t('shared.pagination.last') %></span>
      <% end %>
    </li>
  </ul>
</nav>