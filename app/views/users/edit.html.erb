<% content_for :title, "#{t('users.edit.title')} - Prompto" %>

<% content_for :head do %>
    <%= render "shared/prompt_card_assets" %>
    <%= render "profile_card_assets" %>

    <style data-turbo-track="dynamic">

        .profile-edit-shell {
            width: min(100%, 900px);
            max-width: 900px !important;
            margin: 0 auto;
        }

        .profile-edit-toolbar {
            display: flex;
            flex-wrap: nowrap;
            align-items: center;
            gap: 10px;
            margin-bottom: 1rem;
        }

        .profile-edit-cancel,
        .profile-edit-teams {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            height: 38px;
            min-height: 38px;
            padding: 0 0.9rem;
            border: 1px solid #212529;
            border-radius: 999px;
            background: transparent;
            color: #212529;
            font-weight: 600;
            line-height: 1.2;
            text-decoration: none;
            transition: none;
            white-space: nowrap;
        }

        .profile-edit-cancel:hover,
        .profile-edit-cancel:focus-visible,
        .profile-edit-teams:hover,
        .profile-edit-teams:focus-visible {
            border-color: #212529;
            background: transparent;
            color: #212529;
            box-shadow: none;
            text-decoration: none;
            transform: none;
        }

        .profile-team-modal-backdrop {
            position: fixed;
            inset: 0;
            z-index: 1080;
            background: rgba(24, 24, 27, 0.48);
            display: none;
            align-items: center;
            justify-content: center;
            padding: 1rem;
        }

        .profile-team-modal-backdrop.is-open {
            display: flex;
        }

        .profile-team-modal-card {
            width: min(920px, 100%);
            max-height: min(80vh, 760px);
            overflow: auto;
            background: #fff;
            border-radius: 18px;
            border: 1px solid rgba(61, 53, 47, 0.08);
            box-shadow: 0 18px 40px rgba(61, 53, 47, 0.18);
        }

        .profile-team-modal-header,
        .profile-team-modal-footer {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 0.75rem;
            padding: 1rem 1.1rem;
            border-bottom: 1px solid rgba(61, 53, 47, 0.08);
        }

        .profile-team-modal-footer {
            border-bottom: none;
            border-top: 1px solid rgba(61, 53, 47, 0.08);
        }

        .profile-team-modal-title {
            margin: 0;
            font-size: 1.05rem;
            font-weight: 700;
            color: var(--profile-ink);
        }

        .profile-team-modal-subtitle {
            margin: 0.2rem 0 0;
            font-size: 0.9rem;
            color: var(--profile-muted);
        }

        .profile-team-modal-close {
            border: none;
            background: transparent;
            color: #6b7280;
            font-size: 1rem;
        }

        .profile-team-modal-body {
            padding: 1rem 1.1rem;
        }

        .profile-team-table .form-select {
            min-width: 0;
        }

        .profile-team-role-field {
            position: relative;
            display: inline-flex;
            width: fit-content;
            max-width: 100%;
        }

        .profile-team-role-select.form-select {
            min-width: 170px;
            width: auto;
            max-width: 100%;
            min-height: 42px;
            padding: 0 36px 0 10px;
            border: 1px solid #212529;
            border-radius: 8px;
            background: transparent;
            color: #212529;
            font-size: 0.92rem;
            font-weight: 600;
            line-height: 1.2;
            box-shadow: none;
            appearance: none;
            -webkit-appearance: none;
            -moz-appearance: none;
            background-image: none;
        }

        .profile-team-role-select.form-select:hover {
            border-color: #212529;
            background: transparent;
            color: #212529;
            box-shadow: none;
        }

        .profile-team-role-select.form-select:focus,
        .profile-team-role-select.form-select:focus-visible {
            border-color: var(--app-accent-violet);
            background: transparent;
            color: #212529;
            box-shadow: var(--app-accent-violet-shadow);
            outline: none;
        }

        .profile-team-role-select.form-select:disabled {
            border-color: #d6d0c5;
            background: transparent;
            color: #6c757d;
            opacity: 1;
        }

        .profile-team-role-field .app-dropdown__icon {
            position: absolute;
            top: 50%;
            right: 10px;
            margin-left: 0;
            transform: translateY(-50%);
            color: #212529;
            pointer-events: none;
        }

        .profile-team-role-field .app-dropdown__icon-glyph {
            width: 1rem;
            height: 1rem;
        }

        .profile-team-role-select.form-select:disabled + .app-dropdown__icon {
            color: #6c757d;
        }

        .profile-team-creator-badge {
            display: inline-flex;
            align-items: center;
            gap: 0.4rem;
            padding: 0.2rem 0.55rem;
            border-radius: 999px;
            background: rgba(0, 0, 0, 0.05);
            color: var(--profile-ink);
            font-size: 0.8rem;
            font-weight: 600;
        }

        .profile-team-empty-state {
            padding: 1.25rem;
            border: 1px dashed var(--profile-border);
            border-radius: 14px;
            color: var(--profile-muted);
            background: rgba(248, 249, 250, 0.85);
        }

        .profile-team-modal-create {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            min-height: 38px;
            padding: 0 16px;
            border: 1px solid #212529;
            border-radius: 8px;
            background: #fff;
            color: #212529;
            font-weight: 600;
            text-decoration: none;
            box-shadow: none;
        }

        .profile-team-modal-create:hover,
        .profile-team-modal-create:focus-visible {
            border-color: #212529;
            background: #fff;
            color: #212529;
            text-decoration: none;
            box-shadow: none;
            transform: none;
        }

        @media (max-width: 767.98px) {
            .profile-edit-cancel,
            .profile-edit-teams {
                width: 100%;
            }
        }
    </style>
<% end %>

<% role_options = [[t('users.edit.roles.admin'), 'admin'], [t('users.edit.roles.moderator'), 'moderator'], [t('users.edit.roles.user'), 'user']] %>

<div class="container py-5" style="max-width: 900px;">
    
    <div class="profile-edit-shell">
        
        <%= render 'profile_overview', user: @user, prompt_count: @created_prompts_count, favorite_count: @created_prompts_favorites_count, uses_count: @created_prompts_uses_count, editable_avatar: current_user == @user, card_class: 'mb-3' %>

        <div class="profile-edit-toolbar">
            <%= link_to t('users.edit.profile_button'), user_path(@user), class: 'btn profile-edit-cancel' %>
            <button type="button" class="btn profile-edit-teams" data-profile-team-modal-open="true"><%= t('users.edit.team_button') %></button>
        </div>

    </div>

    <%= render 'form', max_width: '900px' %>

</div>

<%= render "profile_avatar_preview_script" %>
<%= render "team_memberships_modal" %>
<%= render "team_memberships_modal_script" %>