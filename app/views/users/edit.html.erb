<% content_for :title, "#{t('users.edit.title')} - Prompto" %>

<% content_for :head do %>
    <%= render "shared/prompt_card_assets" %>
    <%= render "profile_card_assets" %>

    <style data-turbo-track="dynamic">
        .profile-edit-panel {
            border: 1px solid var(--profile-border);
            border-radius: 18px;
            background: rgba(255, 255, 255, 0.86);
            box-shadow: 0 16px 34px rgba(61, 53, 47, 0.05);
        }

        .profile-edit-page {
            min-height: calc(100vh - 88px);
            display: flex;
            align-items: center;
            padding: 12px 0;
        }

        .profile-edit-shell {
            width: min(100%, 900px);
            max-width: 900px !important;
            margin: 0 auto;
            padding: 0 12px;
        }

        .profile-edit-page .profile-hero {
            height: auto;
            min-height: 146px;
        }

        .profile-edit-page .profile-hero .row {
            height: auto;
        }

        .profile-edit-page .profile-summary {
            height: 130px;
            min-height: 0;
        }

        .profile-edit-page .profile-stats-row {
            gap: 12px !important;
            transform: translateY(1px);
        }

        .profile-edit-page .profile-stat {
            min-width: 104px;
        }

        .profile-edit-panel {
            padding: 20px !important;
        }

        .profile-edit-form .form-label {
            font-weight: 600;
            color: var(--profile-ink);
            margin-bottom: 0.35rem;
        }

        .profile-edit-form .form-control,
        .profile-edit-form .form-select {
            min-height: 44px;
            border-radius: 12px;
            border-color: var(--profile-border);
            background: #fff;
            color: var(--app-text-body);
        }

        .profile-edit-form .form-control:focus,
        .profile-edit-form .form-select:focus {
            border-color: var(--app-accent-violet) !important;
            box-shadow: var(--app-accent-violet-shadow);
        }

        .profile-edit-form .form-text,
        .profile-edit-form .invalid-feedback,
        .profile-edit-form .form-note {
            color: var(--profile-muted);
            margin-top: 0.35rem;
            font-size: 0.84rem;
        }

        .profile-edit-error {
            border: 1px solid rgba(183, 72, 72, 0.2);
            border-radius: 16px;
            background: rgba(255, 245, 245, 0.9);
            color: #8a2d2d;
        }

        .profile-edit-error ul {
            margin-bottom: 0;
            padding-left: 1.25rem;
        }

        .profile-edit-form .row {
            --bs-gutter-x: 0.85rem;
            --bs-gutter-y: 0.85rem;
        }

        .profile-edit-actions {
            display: flex;
            flex-wrap: wrap;
            gap: 0.75rem;
            align-items: center;
        }

        .profile-edit-toolbar {
            display: flex;
            flex-wrap: wrap;
            gap: 0.75rem;
            margin-bottom: 1rem;
        }

        .profile-edit-submit,
        .profile-edit-cancel,
        .profile-edit-teams {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            min-height: 44px;
            padding: 0 1.15rem;
            border-radius: 10px;
            font-weight: 600;
            text-decoration: none;
            transition: all 0.2s ease;
        }

        .profile-edit-submit {
            border: 1px solid #212529;
            background: transparent;
            color: #212529;
        }

        .profile-edit-submit:hover {
            background: #212529;
            border-color: #212529;
            color: #fff;
            transform: translateY(-1px);
        }

        .profile-edit-cancel {
            border: 1px solid var(--profile-border);
            background: #fff;
            color: var(--app-text-body);
        }

        .profile-edit-teams {
            border: 1px solid #212529;
            background: #fff;
            color: #212529;
        }

        .profile-edit-cancel:hover {
            border-color: #d9cdbd;
            color: var(--profile-accent-dark);
            text-decoration: none;
        }

        .profile-edit-teams:hover {
            background: #212529;
            color: #fff;
        }

        .profile-team-modal-backdrop {
            position: fixed;
            inset: 0;
            z-index: 1080;
            background: rgba(24, 24, 27, 0.48);
            display: none;
            align-items: center;
            justify-content: center;
            padding: 1rem;
        }

        .profile-team-modal-backdrop.is-open {
            display: flex;
        }

        .profile-team-modal-card {
            width: min(920px, 100%);
            max-height: min(80vh, 760px);
            overflow: auto;
            background: #fff;
            border-radius: 18px;
            border: 1px solid rgba(61, 53, 47, 0.08);
            box-shadow: 0 18px 40px rgba(61, 53, 47, 0.18);
        }

        .profile-team-modal-header,
        .profile-team-modal-footer {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 0.75rem;
            padding: 1rem 1.1rem;
            border-bottom: 1px solid rgba(61, 53, 47, 0.08);
        }

        .profile-team-modal-footer {
            border-bottom: none;
            border-top: 1px solid rgba(61, 53, 47, 0.08);
        }

        .profile-team-modal-title {
            margin: 0;
            font-size: 1.05rem;
            font-weight: 700;
            color: var(--profile-ink);
        }

        .profile-team-modal-subtitle {
            margin: 0.2rem 0 0;
            font-size: 0.9rem;
            color: var(--profile-muted);
        }

        .profile-team-modal-close {
            border: none;
            background: transparent;
            color: #6b7280;
            font-size: 1rem;
        }

        .profile-team-modal-body {
            padding: 1rem 1.1rem;
        }

        .profile-team-table .form-select {
            min-width: 210px;
        }

        .profile-team-creator-badge {
            display: inline-flex;
            align-items: center;
            gap: 0.4rem;
            padding: 0.2rem 0.55rem;
            border-radius: 999px;
            background: rgba(0, 0, 0, 0.05);
            color: var(--profile-ink);
            font-size: 0.8rem;
            font-weight: 600;
        }

        .profile-team-empty-state {
            padding: 1.25rem;
            border: 1px dashed var(--profile-border);
            border-radius: 14px;
            color: var(--profile-muted);
            background: rgba(248, 249, 250, 0.85);
        }

        @media (max-width: 767.98px) {
            .profile-edit-page {
                min-height: auto;
                display: block;
                padding: 16px 0;
            }

            .profile-edit-submit,
            .profile-edit-cancel,
            .profile-edit-teams {
                width: 100%;
            }
        }
    </style>
<% end %>

<% initials = @user.name.to_s.split.map { |part| part.first }.join.first(2).to_s.upcase.presence || "US" %>
<% prompt_count = @user.created_prompts.count %>
<% favorite_count = @user.created_prompts.sum(:favorites_count) %>
<% uses_count = @user.created_prompts.sum(:uses_count) %>

<div class="profile-edit-page">
    <div class="profile-edit-shell">
        <%= render 'profile_card', user: @user, initials: initials, prompt_count: prompt_count, favorite_count: favorite_count, uses_count: uses_count, editable_avatar: current_user == @user, card_class: 'mb-3', row_class: 'g-3' %>

        <div class="profile-edit-toolbar">
            <%= link_to t('users.edit.profile_button'), user_path(@user), class: 'btn profile-edit-cancel' %>
            <button type="button" class="btn profile-edit-teams" data-profile-team-modal-open="true"><%= t('users.edit.team_button') %></button>
        </div>

        <section class="profile-edit-panel">
            <% if @user.errors.any? %>
                <div class="profile-edit-error p-3 mb-3">
                    <strong class="d-block mb-2"><%= t('users.edit.error_summary') %></strong>
                    <ul>
                        <% @user.errors.full_messages.each do |message| %>
                            <li><%= message %></li>
                        <% end %>
                    </ul>
                </div>
            <% end %>

            <%= form_with model: @user, local: true, data: { turbo: false }, html: { class: 'profile-edit-form' } do |form| %>
                <div class="row">
                    <div class="col-12 col-lg-6">
                        <%= form.label :name, class: 'form-label' %>
                        <%= form.text_field :name, class: 'form-control', autocomplete: 'name' %>
                    </div>

                    <div class="col-12 col-lg-6">
                        <%= form.label :email, class: 'form-label' %>
                        <%= form.email_field :email, class: 'form-control', autocomplete: 'email' %>
                    </div>

                    <% if current_user.admin? %>
                        <div class="col-12 col-lg-4">
                            <%= form.label :role, class: 'form-label' %>
                            <%= form.select :role, options_for_select([[t('users.edit.roles.admin'), 'admin'], [t('users.edit.roles.moderator'), 'moderator'], [t('users.edit.roles.user'), 'user']], @user.role), {}, class: 'form-select' %>
                            <div class="form-text"><%= t('users.edit.role_hint') %></div>
                        </div>

                        <div class="w-100 d-none d-lg-block"></div>
                    <% end %>

                    <div class="col-12 col-lg-4">
                        <%= form.label :password, class: 'form-label' %>
                        <%= form.password_field :password, class: 'form-control', autocomplete: 'new-password' %>
                        <div class="form-text"><%= t('users.edit.password_hint') %></div>
                    </div>

                    <div class="col-12 col-lg-4">
                        <%= form.label :password_confirmation, class: 'form-label' %>
                        <%= form.password_field :password_confirmation, class: 'form-control', autocomplete: 'new-password' %>
                    </div>

                    <div class="col-12 pt-1">
                        <div class="profile-edit-actions">
                            <%= form.submit t('users.edit.submit'), class: 'btn profile-edit-submit' %>
                        </div>
                    </div>
                </div>
            <% end %>
        </section>
    </div>
</div>

<%= render "team_memberships_modal" %>
<%= render "profile_avatar_preview_script" %>
<%= render "team_memberships_modal_script" %>