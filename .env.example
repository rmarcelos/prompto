# Copie este arquivo para .env e ajuste os valores antes de subir a produção.
# Nunca versione o arquivo .env real com segredos.

# Imagem da aplicação
APP_IMAGE=ghcr.io/rmarcelos/prompto:latest

# Banco PostgreSQL
POSTGRES_DB=PROMPTO_PRD
POSTGRES_HOST=<host>
POSTGRES_PORT=<porta>
POSTGRES_USER=<usuario>
POSTGRES_PASSWORD=<senha>

# Rails
SECRET_KEY_BASE=<secret 128 caracteres hexadecimal gerada com rails secret>
APP_HOST=getprompto.org
RAILS_ALLOWED_HOSTS=getprompto.org

# Primeiro usuário administrador criado na primeira execução do seed em produção
SUPERADMIN_EMAIL=<email do superadmin>
SUPERADMIN_PASSWORD=<senha superadmin>
SUPERADMIN_NAME=<Ricardo>

# MinIO / S3 compatível
MINIO_USER=<email do app user do minio>
MINIO_PASSWORD=<senha>
AWS_REGION=us-east-1
AWS_S3_BUCKET=prompto
AWS_ENDPOINT=<endereco https do minio>
AWS_S3_FORCE_PATH_STYLE=true

# SMTP opcional
# SMTP_ADDRESS=smtp.example.com
# SMTP_PORT=587
# SMTP_USER_NAME=usuario_smtp
# SMTP_PASSWORD=senha_smtp
# SMTP_AUTHENTICATION=plain
# SMTP_ENABLE_STARTTLS_AUTO=true
# SMTP_RAISE_DELIVERY_ERRORS=false
# DEVISE_MAILER_SENDER=no-reply@example.com